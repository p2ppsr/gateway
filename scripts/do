#!/usr/bin/env bash
set -euo pipefail
LOG_DIR="logs"; mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/do-$(date +%Y%m%d-%H%M%S).log"
exec > >(tee -a "$LOG_FILE") 2>&1

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "$REPO_ROOT"

PATCHES_DIR="patches"
die(){ echo "❌ $*" >&2; exit 1; }

command -v git >/dev/null 2>&1 || die "git not found"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not in a git repo"

list() { ls -1 "${PATCHES_DIR}"/*.patch 2>/dev/null | xargs -n1 basename || true; }
choose() {
  mapfile -t arr < <(list)
  ((${#arr[@]})) || die "no patches found in ${PATCHES_DIR}/"
  if command -v fzf >/dev/null 2>&1; then
    printf '%s\n' "${arr[@]}" | fzf --prompt="apply patch > " --height=15
  else
    echo "Select a patch to apply:"; PS3="apply patch #: "
    select p in "${arr[@]}"; do [[ -n "${p:-}" ]] && echo "$p" && return; done
  fi
}
norm(){ local n="${1:-}"; [[ "$n" == *.patch ]] || n="${n}.patch"; echo "$n"; }

PATCH_ARG="${1:-}"
PATCH_FILE="${PATCH_ARG:+$(norm "$PATCH_ARG")}"
[[ -n "${PATCH_FILE}" ]] || PATCH_FILE="$(choose)"
PATCH_NAME="${PATCH_FILE%.patch}"
CPR_SCRIPT="scripts/cpr-${PATCH_NAME}-apply.sh"

# If patch file is missing, try CPR directly
if [[ ! -f "${PATCHES_DIR}/${PATCH_FILE}" ]]; then
  if [[ -x "$CPR_SCRIPT" ]]; then
    echo "ℹ️ Patch not found; using CPR fallback: $CPR_SCRIPT"
    "$CPR_SCRIPT"
    echo "✅ CPR applied for ${PATCH_NAME}"
    exit 0
  else
    die "patch not found: ${PATCHES_DIR}/${PATCH_FILE}"
  fi
fi

if [[ -n "$(git status --porcelain)" ]]; then
  read -r -p "⚠️  Working tree has uncommitted changes. Continue applying ${PATCH_FILE}? [y/N] " ans
  [[ "$(echo "$ans" | tr '[:upper:]' '[:lower:]')" == "y" ]] || die "aborted"
fi

# Try normal apply
if git apply --whitespace=fix "${PATCHES_DIR}/${PATCH_FILE}"; then
  echo "✅ applied ${PATCH_FILE}"
  exit 0
fi

# Try 3-way merge
echo "…retrying with 3-way merge"
if git apply -3 --whitespace=fix "${PATCHES_DIR}/${PATCH_FILE}"; then
  echo "✅ applied ${PATCH_FILE} (3-way)"
  exit 0
fi

# CPR fallback on failure
if [[ -x "$CPR_SCRIPT" ]]; then
  echo "⚙️  Falling back to CPR: $CPR_SCRIPT"
  "$CPR_SCRIPT"
  echo "✅ CPR applied for ${PATCH_NAME}"
  exit 0
fi

die "apply failed (and no CPR fallback found: $CPR_SCRIPT)"
