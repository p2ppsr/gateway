{
  "name": "gatewaycash",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:site": "webpack serve --config webpack.dev.ts",
    "dev:server": "nodemon --watch src --ext ts,js --exec \"node -r ts-node/register src/server.js\"",
    "watch:pay": "bash scripts/watch-pay.sh",
    "dev": "concurrently \"npm run dev:site\" \"npm run dev:server\" \"npm run watch:pay\"",
    "build:site": "webpack --config webpack.site.ts",
    "build:inject": "webpack --config webpack.inject.ts",
    "build": "concurrently \"npm run build:site\" \"npm run build:inject\"",
    "setup:db": "knex migrate:latest && knex seed:run",
    "lint": "ts-standard --fix .",
    "prettier": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "clean": "rimraf dist node_modules && npm install",
    "start:server": "node src/server.js",
    "setup:server": "node src/setup.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@bsv/auth-express-middleware": "^2.2.1",
    "@bsv/payment-express-middleware": "^2.1.5",
    "@bsv/sdk": "^2.4.0",
    "@bsv/wallet-toolbox": "^2.9.0",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.17",
    "@mui/material": "^5.15.7",
    "@mui/styles": "^5.15.14",
    "amountinator": "^0.2.9",
    "amountinator-react": "^0.1.36",
    "axios": "^1.10.0",
    "body-parser": "^1.20.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "knex": "^3.1.0",
    "mysql2": "^3.9.3",
    "prettyjson": "^1.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "^0.80.1",
    "react-native-web": "^0.20.0",
    "react-qr-code": "^2.0.18",
    "react-router-dom": "^6.23.1",
    "react-syntax-highlighter": "^15.6.1",
    "react-toastify": "^9.1.3",
    "use-async-effect": "^2.2.7"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/plugin-transform-react-jsx": "^7.23.4",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@types/node": "^22.16.5",
    "@types/prettyjson": "^0.0.33",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/webpack": "^5.28.5",
    "@types/webpack-dev-server": "^4.7.2",
    "babel-loader": "^8.3.0",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.10.0",
    "dotenv-webpack": "^8.1.1",
    "esbuild": "^0.25.8",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^29.7.0",
    "node-polyfill-webpack-plugin": "^1.1.4",
    "nodemon": "^3.1.0",
    "sass": "^1.89.2",
    "sass-loader": "^14.1.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "ts-standard": "^12.0.2",
    "tsx": "^4.20.3",
    "typescript": "^5.4.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^5.8.0"
  },
  "overrides": {
    "amountinator": {
      "@bsv/wallet-toolbox-client": "2.9.0"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "ts-standard": {
    "ignore": ["public/**"]
  }
}
