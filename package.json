{
  "name": "gatewaycash",
  "version": "1.9.0",
  "private": true,
  "scripts": {
    "build:demoIdsAuth1": "webpack --config webpack.demo.js",
    "start": "node dist/server.js",
    "dev:server": "DOTENV_CONFIG_PATH=.env.local NODE_OPTIONS=--enable-source-maps nodemon --watch src --ext ts,js,json --signal SIGTERM --exec \"node -r dotenv/config -r ts-node/register/transpile-only src/server.ts\"",
    "migrate:local": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config -r ts-node/register/transpile-only ./node_modules/knex/bin/cli.js --knexfile src/knexfile.ts migrate:latest",
    "dev:site": "webpack serve --config webpack.dev.ts",
    "watch:pay": "bash scripts/watch-pay.sh",
    "dev": "concurrently \"npm run dev:site\" \"npm run watch:pay\"",
    "build:site": "webpack --config webpack.site.ts",
    "build:inject": "webpack --config webpack.inject.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "concurrently \"npm run build:site\" \"npm run build:inject\" \"npm run build:server\"",
    "setup:db": "node scripts/mkenv.sh && knex migrate:latest && knex seed:run",
    "lint": "ts-standard --fix .",
    "prettier": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "clean": "rimraf dist node_modules && npm install",
    "start:server": "node src/server.js",
    "setup:server": "node src/setup.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@bsv/auth-express-middleware": "^1.2.0",
    "@bsv/payment-express-middleware": "^1.2.1",
    "@bsv/sdk": "^1.6.24",
    "@bsv/wallet-toolbox": "^1.5.9",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.17",
    "@mui/material": "^5.15.7",
    "@mui/styles": "^5.15.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-hooks": "^8.0.1",
    "amountinator": "^0.2.9",
    "amountinator-react": "^0.1.36",
    "axios": "^1.10.0",
    "body-parser": "^1.20.2",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jest-environment-jsdom": "^30.1.2",
    "jsdom": "^26.1.0",
    "knex": "^3.1.0",
    "mysql2": "^3.9.3",
    "prettyjson": "^1.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "^0.80.1",
    "react-native-web": "^0.20.0",
    "react-qr-code": "^2.0.18",
    "react-router-dom": "^6.23.1",
    "react-syntax-highlighter": "^15.6.1",
    "react-toastify": "^9.1.3",
    "use-async-effect": "^2.2.7"
