{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "commonjs",
    "target": "ES2021",
    "lib": [
      "ES2021"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "noEmitOnError": false
  },
  "include": [
    "src/**/*.ts",
    "src/types.d.ts",
    "knexfile.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public",
    "migrations",
    "tests",
    "knexfile.ts"
  ]
}
